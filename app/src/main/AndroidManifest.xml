<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 悬浮窗（桌宠）+ 前台服务 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 导入流水线 WakeLock：防导入途中息屏 CPU 休眠中断解压/贴图压缩 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 语音唤醒：常驻监听麦克风（RECORD_AUDIO 需运行时申请） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".MineAvataApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MineAvata">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MineAvata">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".pet.PetService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Live2D desktop pet overlay" />
        </service>

        <!-- 语音唤醒监听：与桌宠服务相互独立（两个开关互不影响） -->
        <service
            android:name=".voice.VoiceWakeService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>

    <!-- Android 11+ 包可见性：让 SpeechRecognizer 能发现系统识别服务 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

</manifest>